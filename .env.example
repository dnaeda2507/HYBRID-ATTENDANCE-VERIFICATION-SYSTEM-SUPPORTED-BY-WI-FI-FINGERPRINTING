# ============================================================
# Production environment variables
# Copy this file to .env and fill in every value.
# NEVER commit .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SA password for SQL Server (min 8 chars, must contain upper+lower+digit+symbol)
DB_PASSWORD=Change_This_Strong_P@ssword1
DB_NAME=CSEProject

# ── JWT ──────────────────────────────────────────────────────
# Must be a long random string (32+ chars).
# Generate one: openssl rand -hex 32
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# C# backend (appsettings.json) ve FastAPI ile aynı olmalı
JWT_ISSUER=CoreIdentity
JWT_AUDIENCE=CoreIdentityUser
JWT_DURATION=3600

# development = IP/BSSID kontrolleri gevşetilir (yerel test için)
# production = tam güvenlik kontrolleri (canlı ortam)
ENVIRONMENT=development

# ── Internal token (backend ↔ ML service) ────────────────────
# Generate one: openssl rand -hex 24
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_SECRET

# ── SMTP / Mail ───────────────────────────────────────────────
MAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# For Gmail use an App Password (not your account password)
SMTP_PASS=your-app-password
MAIL_DISPLAY_NAME=Attendance System

# ── Frontend ──────────────────────────────────────────────────
# Public URL of the backend reachable from the *browser* (not inside Docker).
# If you have a domain: http://api.yourdomain.com:9001
# Otherwise use your server IP: http://123.45.67.89:9001
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:9001
